<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - <%= stats.botName %></title>
    <style>
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background-color: #16161e; 
            color: #a9b1d6; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; /* Changed from height to min-height */
            margin: 0;
            padding: 20px; /* Adds breathing room for mobile */
        }
        .login-card { 
            background-color: #1a1b26; 
            padding: 40px; 
            border-radius: 12px; 
            border: 1px solid #2f3549; 
            text-align: center; 
            width: 100%; /* Default to full width */
            max-width: 350px; /* Keeps the card from getting too wide */
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        h1 { color: #7aa2f7; margin-bottom: 10px; }
        p { color: #565f89; margin-bottom: 30px; font-size: 0.95rem; }
        .btn-discord { 
            background-color: #5865F2; 
            color: white; 
            padding: 12px 24px; 
            border-radius: 6px; 
            text-decoration: none; 
            font-weight: bold; 
            display: inline-block;
            transition: background 0.2s;
            width: 100%; /* Makes button hit-area better on mobile */
            box-sizing: border-box;
        }
        .btn-discord:hover { background-color: #4752C4; }

        /* Mobile Optimization */
        @media (max-width: 480px) {
            .login-card {
                padding: 25px; /* Less padding on very small screens */
            }
            h1 { font-size: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h1>🌌 <%= stats.botName %></h1>
        <p>Access the dashboard for OsQarek's Universe Utilities. Must be a Moderator +.</p>
        <a href="/auth/discord" class="btn-discord">Login with Discord</a>
    </div>
</body>
</html>
