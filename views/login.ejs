<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login - <%= stats.botName %></title>
    <style>
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background-color: #16161e; 
            color: #a9b1d6; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
        }
        .login-card { 
            background-color: #1a1b26; 
            padding: 40px; 
            border-radius: 12px; 
            border: 1px solid #2f3549; 
            text-align: center; 
            width: 350px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        h1 { color: #7aa2f7; margin-bottom: 10px; }
        p { color: #565f89; margin-bottom: 30px; }
        .btn-discord { 
            background-color: #5865F2; 
            color: white; 
            padding: 12px 24px; 
            border-radius: 6px; 
            text-decoration: none; 
            font-weight: bold; 
            display: inline-block;
            transition: background 0.2s;
        }
        .btn-discord:hover { background-color: #4752C4; }
    </style>
</head>
<body>
    <div class="login-card">
        <h1>🌌 <%= stats.botName %></h1>
        <p>Access the core command center.</p>
        <a href="/auth/discord" class="btn-discord">Login with Discord</a>
    </div>
</body>
</html>
