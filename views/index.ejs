<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= stats.botName %> - Terminal Controls</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #1a1b26; color: #a9b1d6; margin: 0; padding: 30px; }
        .wrapper { max-width: 1200px; margin: 0 auto; }
        
        /* Navbar Layout */
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #24283b; padding-bottom: 25px; margin-bottom: 30px; }
        h1 { color: #7aa2f7; margin: 0; font-size: 1.8rem; }
        .user-panel { display: flex; align-items: center; gap: 15px; }
        .user-panel img { width: 35px; height: 35px; border-radius: 50%; border: 2px solid #7aa2f7; }
        .btn-logout { background-color: #f7768e; color: #1a1b26; text-decoration: none; padding: 6px 14px; border-radius: 6px; font-weight: bold; font-size: 0.85rem; }

        /* Statistics Structure */
        .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .card-stat { background-color: #24283b; padding: 20px; border-radius: 10px; border: 1px solid #2f3549; }
        .card-stat h3 { margin: 0 0 5px 0; font-size: 0.8rem; color: #7dcfff; text-transform: uppercase; letter-spacing: 0.5px; }
        .card-stat .val { font-size: 1.8rem; font-weight: bold; color: #c0caf5; }

        /* Configuration Panels split */
        .layout-split { display: grid; grid-template-columns: 2fr 1fr; gap: 30px; margin-bottom: 30px; }
        @media(max-width: 900px) { .layout-split { grid-template-columns: 1fr; } }
        
        .panel { background-color: #24283b; padding: 25px; border-radius: 12px; border: 1px solid #2f3549; margin-bottom: 30px; }
        .panel h2 { margin-top: 0; color: #bb9af7; font-size: 1.3rem; border-bottom: 1px solid #2f3549; padding-bottom: 10px; margin-bottom: 20px; }

        /* Interactive Forms */
        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 0.85rem; color: #7dcfff; margin-bottom: 5px; }
        input[type="text"], textarea { width: 100%; padding: 10px; background-color: #1a1b26; border: 1px solid #2f3549; color: #c0caf5; border-radius: 6px; box-sizing: border-box; }
        .btn-submit { background-color: #7aa2f7; color: #1a1b26; border: none; padding: 10px 18px; font-weight: bold; border-radius: 6px; cursor: pointer; display: inline-block; margin-top: 5px; }

        /* Terminal Logging Interface */
        .terminal-box { background-color: #15161e; font-family: 'Courier New', monospace; padding: 15px; border-radius: 8px; height: 180px; overflow-y: auto; font-size: 0.85rem; border: 1px solid #1f2335; }
        .log-ln { margin-bottom: 4px; line-height: 1.4; }
        .log-time { color: #565f89; margin-right: 8px; }
        .log-err { color: #f7768e; }
        .log-text { color: #9ece6a; }

        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #2f3549; }
        th { color: #7dcfff; font-weight: normal; }
    </style>
</head>
<body>
    <div class="wrapper">
        <header>
            <h1>🌌 <%= stats.botName %> Utilities</h1>
            <div class="user-panel">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar">
                <span><%= user.username %></span>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </header>

        <div class="grid-stats">
            <div class="card-stat"><h3>System Status</h3><div class="val" style="color: #9ece6a;"><%= stats.botStatus %></div></div>
            <div class="card-stat"><h3>Gateway Ping</h3><div class="val"><%= stats.ping %></div></div>
            <div class="card-stat"><h3>Total Guilds</h3><div class="val"><%= stats.guildsCount %></div></div>
            <div class="card-stat"><h3>Tracked Cases</h3><div class="val"><%= cases.length %></div></div>
        </div>

        <div class="layout-split">
            <div class="left-col">
                
                <div class="panel">
                    <h2>⚙️ Global System Configuration</h2>
                    <form action="/update-settings" method="POST">
                        <div class="form-group">
                            <label>WELCOME CHANNEL ID</label>
                            <input type="text" name="welcomeChannel" value="<%= settings.welcomeChannel %>" required>
                        </div>
                        <div class="form-group">
                            <label>GOODBYE CHANNEL ID</label>
                            <input type="text" name="goodbyeChannel" value="<%= settings.goodbyeChannel %>" required>
                        </div>
                        <button type="submit" class="btn-submit">Save System Changes</button>
                    </form>
                </div>

                <div class="panel">
                    <h2>DM Sender</h2>
                    <form action="/dm-user" method="POST">
                        <div class="form-group">
                            <label>TARGET DISCORD USER ID</label>
                            <input type="text" name="userId" placeholder="e.g. 234567890123456789" required>
                        </div>
                        <div class="form-group">
                            <label>MESSAGE</label>
                            <textarea name="dmMessage" rows="3" placeholder="Type direct transmission payload here..." required></textarea>
                        </div>
                        <button type="submit" class="btn-submit">Dispatch Anonymous DM</button>
                    </form>
                </div>
            </div>

            <div class="right-col">
                
                <div class="panel">
                    <h2>🎭 Reaction Roles</h2>
                    <form action="/reaction-roles/add" method="POST" style="margin-bottom: 20px;">
                        <div class="form-group"><label>MESSAGE ID</label><input type="text" name="messageId" required></div>
                        <div class="form-group"><label>EMOJI</label><input type="text" name="emoji" placeholder="e.g. ✅" required></div>
                        <div class="form-group"><label>ROLE ID</label><input type="text" name="roleId" required></div>
                        <button type="submit" class="btn-submit" style="width: 100%;">Map Reaction Role</button>
                    </form>

                    <table>
                        <thead>
                            <tr><th>Emoji</th><th>Role Destination</th></tr>
                        </thead>
                        <tbody>
                            <% reactionRoles.forEach(rr => { %>
                                <tr><td><%= rr.emoji %></td><td><code style="color: #7aa2f7;"><%= rr.roleId %></code></td></tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="panel">
            <h2>⚖️ Infraction Database Registries</h2>
            <% if (cases.length === 0) { %>
                <p style="color: #565f89; font-style: italic;">No disciplinary logs recorded inside current memory parameters.</p>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Case ID</th>
                            <th>Target User</th>
                            <th>Type</th>
                            <th>Reason Parameter Modification</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cases.forEach((item, index) => { %>
                            <tr>
                                <td>#<%= index %></td>
                                <td><span style="color: #e0af68;"><%= item.user || item.userId %></span></td>
                                <td><strong><%= item.action || 'WARNING' %></strong></td>
                                <td>
                                    <form action="/edit-case/<%= index %>" method="POST" style="display: flex; gap: 8px;">
                                        <input type="text" name="reason" value="<%= item.reason %>" style="padding: 5px;">
                                        <button type="submit" class="btn-submit" style="margin:0; padding: 5px 10px;">Update</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>

        <div class="panel">
            <h2>🖥️ Live System Core Console Output</h2>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label style="margin-bottom: 5px; display: block; color: #9ece6a;">STANDARD CONSOLE ACTIVITY LOGS</label>
                    <div class="terminal-box">
                        <% logs.slice().reverse().forEach(log => { %>
                            <div class="log-ln"><span class="log-time">[<%= log.time %>]</span><span class="log-text"><%= log.text %></span></div>
                        <% }) %>
                    </div>
                </div>
                <div>
                    <label style="margin-bottom: 5px; display: block; color: #f7768e;">SYSTEM RUNTIME ERROR STACKS</label>
                    <div class="terminal-box" style="border-color: rgba(247, 118, 142, 0.2);">
                        <% errors.slice().reverse().forEach(err => { %>
                            <div class="log-ln"><span class="log-time">[<%= err.time %>]</span><span class="log-err"><%= err.text %></span></div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>