<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body { margin: 0; display: flex; font-family: 'Segoe UI', sans-serif; background-color: #16161e; color: #a9b1d6; }
        
        /* Sidebar */
        .sidebar { width: 250px; background: #1a1b26; height: 100vh; border-right: 1px solid #2f3549; padding: 20px; }
        .sidebar h2 { color: #7aa2f7; font-size: 1.2rem; }
        .nav-btn { display: block; width: 100%; padding: 12px; margin: 5px 0; background: transparent; border: none; color: #a9b1d6; text-align: left; cursor: pointer; border-radius: 6px; font-weight: bold; }
        .nav-btn:hover, .nav-btn.active { background: #24283b; color: #7dcfff; }

        /* Main Content */
        .main-content { flex: 1; padding: 40px; overflow-y: auto; }
        .panel { background-color: #24283b; padding: 25px; border-radius: 8px; border: 1px solid #2f3549; margin-bottom: 20px; }
        
        /* Utility Styles */
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        h2 { color: #bb9af7; margin-top: 0; }
        .btn-submit { background-color: #7aa2f7; color: #1a1b26; border: none; padding: 10px 18px; border-radius: 4px; cursor: pointer; font-weight: bold; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>🌌 Utilities</h2>
        <button class="nav-btn active" onclick="showTab('dashboard')">Dashboard</button>
        <button class="nav-btn" onclick="showTab('infractions')">Infractions</button>
        <button class="nav-btn" onclick="showTab('logs')">Logs</button>
    </div>

    <div class="main-content">
        <div id="dashboard" class="tab-content active">
            <h2>Dashboard</h2>
            <div class="panel">...</div>
        </div>
        <div id="infractions" class="tab-content">
            <h2>Infractions</h2>
            <div class="panel">...</div>
        </div>
        <div id="logs" class="tab-content">
            <h2>System Logs</h2>
            <div class="panel">...</div>
        </div>
    </div>

    <script>
        function showTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');
        }
    </script>
</body>
</html>
