<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <title><%= stats.botName %> - Dashboard</title>
    <style>
        :root { --sidebar-bg: #1a1b26; --main-bg: #16161e; --accent: #7aa2f7; --card-bg: #24283b; --text: #a9b1d6; }
        body { font-family: 'Segoe UI', sans-serif; background-color: var(--main-bg); color: var(--text); margin: 0; display: flex; height: 100vh; }
        
        /* Sidebar */
        .sidebar { width: 260px; background: var(--sidebar-bg); border-right: 1px solid #2f3549; display: flex; flex-direction: column; padding: 20px; }
        .sidebar h2 { color: var(--accent); font-size: 1.2rem; margin-bottom: 2rem; }
        .tab-btn { background: transparent; border: none; color: var(--text); padding: 12px 15px; border-radius: 6px; text-align: left; cursor: pointer; font-weight: bold; margin-bottom: 5px; transition: 0.2s; }
        .tab-btn:hover, .tab-btn.active { background: #2f3549; color: var(--accent); }
        
        /* Main Content */
        .main-content { flex: 1; padding: 40px; overflow-y: auto; }
        .panel { background: var(--card-bg); padding: 25px; border-radius: 8px; border: 1px solid #2f3549; margin-bottom: 25px; }
        h2 { color: #fff; font-size: 1.4rem; margin-top: 0; }
        
        .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 25px; }
        .card-stat { background: var(--card-bg); padding: 20px; border-radius: 6px; border: 1px solid #2f3549; }
        .card-stat h3 { font-size: 0.75rem; color: #7dcfff; text-transform: uppercase; margin: 0; }
        .card-stat .val { font-size: 1.5rem; font-weight: bold; color: #c0caf5; margin-top: 5px; }
        
        input { background: #16161e; border: 1px solid #2f3549; color: #fff; padding: 10px; border-radius: 4px; width: 100%; box-sizing: border-box; }
        .btn-submit { background: var(--accent); color: #1a1b26; border: none; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { text-align: left; color: #565f89; font-size: 0.8rem; padding: 10px; }
        td { padding: 10px; border-bottom: 1px solid #2f3549; }

        .terminal-box { background-color: #15161e; font-family: monospace; padding: 15px; border-radius: 8px; height: 300px; overflow-y: auto; border: 1px solid #1f2335; font-size: 0.8rem; }
        
        @media (max-width: 768px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; height: auto; border-right: none; border-bottom: 1px solid #2f3549; padding: 10px; flex-direction: row; overflow-x: auto; }
            .sidebar h2 { display: none; }
            .tab-btn { margin-bottom: 0; padding: 10px; white-space: nowrap; }
            .main-content { padding: 20px; }
            .grid-stats { grid-template-columns: 1fr; }
            .panel { overflow-x: auto; }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2> OsQarek's Universe Utilities </h2>
        <button class="tab-btn active" onclick="openTab(event, 'dashboard')">⚙️ Configuration</button>
        <button class="tab-btn" onclick="openTab(event, 'infractions')">⚖️ Infractions</button>
        <button class="tab-btn" onclick="openTab(event, 'risk-manager')">🛡️ Risk Manager</button>
        <button class="tab-btn" onclick="openTab(event, 'roles')">🎭 Reaction Roles</button>
        <button class="tab-btn" onclick="openTab(event, 'terminal')">🖥️ System Logs</button>
        <div style="margin-top: auto;">
            <a href="/logout" style="color: #f7768e; text-decoration: none; font-weight: bold;">Logout</a>
        </div>
    </div>

    <div class="main-content">
        <div id="dashboard" class="tab-content active">
            <h2>Dashboard</h2>
            <div class="grid-stats">
                <div class="card-stat"><h3>Status</h3><div class="val" style="color:#9ece6a"><%= stats.botStatus %></div></div>
                <div class="card-stat"><h3>Ping</h3><div class="val"><%= stats.ping %></div></div>
                <div class="card-stat"><h3>Guilds</h3><div class="val"><%= stats.guildsCount %></div></div>
            </div>
            <div class="panel">
                <h2>System Settings</h2>
                <form action="/update-settings" method="POST">
                    <label>Welcome Channel ID</label><input name="welcomeChannel" value="<%= settings.welcomeChannel %>">
                    <label style="margin-top:10px; display:block">Goodbye Channel ID</label><input name="goodbyeChannel" value="<%= settings.goodbyeChannel %>">
                    <button type="submit" class="btn-submit">Save Changes</button>
                </form>
            </div>
        </div>

        <div id="infractions" class="tab-content">
            <div class="panel">
                <h2>⚖️ Infraction Database Registry</h2>
                <% if (cases.length === 0) { %> 
                    <p style="color: #565f89;">No records found.</p> 
                <% } else { %>
                    <table>
                        <thead><tr><th>ID</th><th>User</th><th>Type</th><th>Reason</th></tr></thead>
                        <tbody>
                            <% cases.forEach((item, index) => { %>
                            <tr>
                                <td style="color: #7dcfff;">#<%= index %></td>
                                <td><%= item.user || item.userId %></td>
                                <td><strong><%= item.type || 'UNKNOWN' %></strong></td>
                                <td>
                                    <form action="/edit-case/<%= index %>" method="POST" style="display:flex; gap:8px;">
                                        <input type="text" name="reason" value="<%= item.reason %>">
                                        <button type="submit" class="btn-submit" style="margin-top:0;">Update</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>

   <div id="risk-manager" class="tab-content">
    <div class="panel">
        <h2>🛡️ Member Risk Assessment</h2>
        <table>
            <thead>
                <tr>
                    <th>Member Tag</th>
                    <th>Risk Score</th>
                    <th>Reason</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (members && members.length > 0) { %>
                    <% members.forEach(member => { %>
                        <% 
                            // --- RISK CALCULATION LOGIC ---
                            let risk = 10;
                            let reasons = [];
                            
                            // 1. Join Date Check (Within 7 days)
                            if (member.joinedTimestamp > (Date.now() - 604800000)) { 
                                risk += 40; 
                                reasons.push("Joined < 7d"); 
                            }
                            
                            // 2. Account Age Check (Discord ID Snowflake Calculation)
                            const discordEpoch = 1420070400000;
                            const userId = BigInt(member.id);
                            const creationTimestamp = Number((userId >> 22n) + BigInt(discordEpoch));
                            const accountAgeYears = (Date.now() - creationTimestamp) / (1000 * 60 * 60 * 24 * 365);
                            
                            if (accountAgeYears < 1) { 
                                risk += 35; 
                                reasons.push("Acct < 1yr"); 
                            }
                            
                            // 3. Avatar Check
                            if (!member.user.avatar) { 
                                risk += 15; 
                                reasons.push("No Avatar"); 
                            }
                        %>
                        <tr>
                            <td><%= member.user.tag %></td>
                            <td>
                                <span style="color: <%= risk >= 60 ? '#f7768e' : '#9ece6a' %>;">
                                    <%= risk %>/100 (<%= risk >= 60 ? 'High' : 'Low' %>)
                                </span>
                            </td>
                            <td>
                                <%= reasons.length > 0 ? reasons.join(', ') : "Verified Account" %>
                            </td>
                            <td>
                                <form action="/review-risk/<%= member.id %>" method="POST">
                                    <button type="submit" class="btn-submit">Review</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4">No members found or intent not enabled.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

        <div id="roles" class="tab-content">
    <div class="panel">
        <h2>🎭 Reaction Role Configuration</h2>
        <form action="/add-reaction-role" method="POST" style="display: flex; gap: 10px; flex-wrap: wrap;">
            
            <select name="emoji" style="width: 150px; background: #16161e; color: #fff; padding: 10px; border-radius: 4px; border: 1px solid #2f3549;">
                <option value="">Select Emoji</option>
                <% if (typeof emojis !== 'undefined' && emojis && emojis.length > 0) { %>
                    <% emojis.forEach(emoji => { %>
                        <option value="<%= emoji.toString %>">
                            <%= emoji.toString %> :<%= emoji.name %>:
                        </option>
                    <% }) %>
                <% } else { %>
                    <option value="" disabled>No custom emojis available</option>
                <% } %>
            </select>

            <input name="roleId" placeholder="Role ID" style="flex: 2;">
            <input name="messageId" placeholder="Message ID" style="flex: 2;">
            <button type="submit" class="btn-submit" style="margin-top:0;">Add Rule</button>
        </form>
    </div>
</div>

        <div id="terminal" class="tab-content">
            <div class="panel">
                <h2>🖥️ Live System Logs</h2>
                <div class="terminal-box"><% logs.slice().reverse().forEach(log => { %><div>[<%= log.time %>] <%= log.text %></div><% }) %></div>
            </div>
        </div>
    </div>

   <script>
    function openTab(evt, tabId) {
        // 1. Remove active classes
        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        
        // 2. Add active classes
        document.getElementById(tabId).classList.add('active');
        
        // If triggered by a click, update the button class
        if (evt && evt.currentTarget) {
            evt.currentTarget.classList.add('active');
        } else {
            // If triggered by URL hash, find the button and activate it
            const btn = document.querySelector(`.tab-btn[onclick*="${tabId}"]`);
            if (btn) btn.classList.add('active');
        }
        
        // 3. Update the URL hash
        window.location.hash = tabId;
    }

    // NEW: Logic to handle tab switching on page load
    window.addEventListener('load', () => {
        const hash = window.location.hash.substring(1); // e.g., "risk-manager"
        if (hash) {
            const targetTab = document.getElementById(hash);
            if (targetTab) {
                openTab(null, hash);
            }
        }
    });
</script>
</body>
</html>
