<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= stats.botName %> - Terminal Controls</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #1a1b26; color: #a9b1d6; margin: 0; padding: 30px; }
        .wrapper { max-width: 1200px; margin: 0 auto; }
        
        /* Navbar Layout */
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #24283b; padding-bottom: 25px; margin-bottom: 30px; }
        h1 { color: #7aa2f7; margin: 0; font-size: 1.8rem; }
        .user-panel { display: flex; align-items: center; gap: 15px; }
        .user-panel img { width: 35px; height: 35px; border-radius: 50%; border: 2px solid #7aa2f7; }
        .btn-logout { background-color: #f7768e; color: #1a1b26; text-decoration: none; padding: 6px 14px; border-radius: 6px; font-weight: bold; font-size: 0.85rem; }

        /* Tabs */
        .tab-nav { display: flex; gap: 10px; margin-bottom: 30px; }
        .tab-btn { background: #24283b; border: 1px solid #2f3549; color: #a9b1d6; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-weight: bold; }
        .tab-btn.active { background: #7aa2f7; color: #1a1b26; border-color: #7aa2f7; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* Statistics */
        .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .card-stat { background-color: #24283b; padding: 20px; border-radius: 10px; border: 1px solid #2f3549; }
        .card-stat h3 { margin: 0 0 5px 0; font-size: 0.8rem; color: #7dcfff; text-transform: uppercase; }
        .card-stat .val { font-size: 1.8rem; font-weight: bold; color: #c0caf5; }

        .layout-split { display: grid; grid-template-columns: 2fr 1fr; gap: 30px; margin-bottom: 30px; }
        .panel { background-color: #24283b; padding: 25px; border-radius: 12px; border: 1px solid #2f3549; margin-bottom: 30px; }
        .panel h2 { margin-top: 0; color: #bb9af7; font-size: 1.3rem; border-bottom: 1px solid #2f3549; padding-bottom: 10px; margin-bottom: 20px; }

        input, textarea { width: 100%; padding: 10px; background-color: #1a1b26; border: 1px solid #2f3549; color: #c0caf5; border-radius: 6px; box-sizing: border-box; }
        .btn-submit { background-color: #7aa2f7; color: #1a1b26; border: none; padding: 10px 18px; font-weight: bold; border-radius: 6px; cursor: pointer; margin-top: 5px; }

        .terminal-box { background-color: #15161e; font-family: 'Courier New', monospace; padding: 15px; border-radius: 8px; height: 400px; overflow-y: auto; font-size: 0.85rem; border: 1px solid #1f2335; }
        .log-ln { margin-bottom: 4px; line-height: 1.4; }
        .log-time { color: #565f89; margin-right: 8px; }
        .log-err { color: #f7768e; }
        .log-text { color: #9ece6a; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #2f3549; }
    </style>
</head>
<body>
    <div class="wrapper">
        <header>
            <h1>🌌 <%= stats.botName %> Utilities</h1>
            <div class="user-panel">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar">
                <span><%= user.username %></span>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </header>

        <div class="tab-nav">
            <button class="tab-btn active" onclick="openTab(event, 'dashboard')">⚙️ Dashboard</button>
            <button class="tab-btn" onclick="openTab(event, 'terminal')">🖥️ Terminal Console</button>
        </div>

        <div id="dashboard" class="tab-content active">
            <div class="grid-stats">
                <div class="card-stat"><h3>System Status</h3><div class="val" style="color: #9ece6a;"><%= stats.botStatus %></div></div>
                <div class="card-stat"><h3>Gateway Ping</h3><div class="val"><%= stats.ping %></div></div>
                <div class="card-stat"><h3>Total Guilds</h3><div class="val"><%= stats.guildsCount %></div></div>
                <div class="card-stat"><h3>Tracked Cases</h3><div class="val"><%= cases.length %></div></div>
            </div>
            <div class="layout-split">
                <div class="left-col">
                    <div class="panel">
                        <h2>⚙️ Configuration</h2>
                        <form action="/update-settings" method="POST">
                            <div style="margin-bottom:15px"><label>WELCOME CHANNEL ID</label><input type="text" name="welcomeChannel" value="<%= settings.welcomeChannel %>" required></div>
                            <div style="margin-bottom:15px"><label>GOODBYE CHANNEL ID</label><input type="text" name="goodbyeChannel" value="<%= settings.goodbyeChannel %>" required></div>
                            <button type="submit" class="btn-submit">Save System Changes</button>
                        </form>
                    </div>
                </div>
                <div class="right-col">
                    <div class="panel"><h2>🎭 Reaction Roles</h2>...</div>
                </div>
            </div>
            <div class="panel"><h2>⚖️ Infraction Database</h2>...</div>
        </div>

        <div id="terminal" class="tab-content">
            <div class="panel">
                <h2>🖥️ Live System Core Console</h2>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="color: #9ece6a;">STANDARD LOGS</label>
                        <div class="terminal-box"><% logs.slice().reverse().forEach(log => { %><div class="log-ln"><span class="log-time">[<%= log.time %>]</span><span class="log-text"><%= log.text %></span></div><% }) %></div>
                    </div>
                    <div>
                        <label style="color: #f7768e;">ERROR STACKS</label>
                        <div class="terminal-box"><% errors.slice().reverse().forEach(err => { %><div class="log-ln"><span class="log-time">[<%= err.time %>]</span><span class="log-err"><%= err.text %></span></div><% }) %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openTab(evt, tabId) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            evt.currentTarget.classList.add('active');
        }
    </script>
</body>
</html>
