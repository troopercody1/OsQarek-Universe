<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Master Settings</title>
    </head>
<body>
    <nav>
        <a href="/">Back to Dashboard</a>
    </nav>

    <h1>Master Admin Settings</h1>

    <div class="settings-card">
        <h3>Maintenance Mode</h3>
        <p>Current Status: <strong><%= settings.maintenanceMode ? 'ACTIVE' : 'INACTIVE' %></strong></p>
        <form action="/settings/toggle-maintenance" method="POST">
            <button type="submit">
                <%= settings.maintenanceMode ? 'Disable Maintenance' : 'Enable Maintenance' %>
            </button>
        </form>
    </div>

    </body>
</html>
