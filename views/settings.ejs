<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Master Settings</title>
    <style>
        /* Copying your login theme for consistency */
        body { font-family: 'Segoe UI', sans-serif; background-color: #16161e; color: #a9b1d6; padding: 40px; margin: 0; }
        .settings-card { background-color: #1a1b26; padding: 30px; border-radius: 12px; border: 1px solid #2f3549; max-width: 600px; margin: 20px auto; }
        h1, h3 { color: #7aa2f7; }
        button { background-color: #5865F2; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; }
        button:hover { background-color: #4752C4; }
        a { color: #7aa2f7; text-decoration: none; }
    </style>
</head>
<body>
    <div class="settings-card">
        <a href="/">← Back to Dashboard</a>
        <h1>Website Settings</h1>
        
        <h3>Maintenance Mode</h3>
        <p>Status: <strong><%= settings.maintenanceMode ? 'Locked' : 'Unlocked' %></strong></p>
        <form action="/settings/toggle-maintenance" method="POST">
            <button type="submit"><%= settings.maintenanceMode ? 'Disable Maintenance' : 'Enable Maintenance' %></button>
        </form>
    </div>
</body>
</html>
