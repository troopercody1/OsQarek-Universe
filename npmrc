# @discordjs/voice lists native addons (@discordjs/opus, sodium-native,
# zlib-sync, bufferutil, utf-8-validate, etc.) as optional dependencies for
# performance. Railway's Nixpacks build image doesn't have Python/build
# tools installed, so npm's fallback source compile for these fails and
# takes the whole `npm install` down with it.
#
# We skip all optional deps here and instead depend directly on pure-JS
# equivalents (opusscript, libsodium-wrappers) in package.json, which need
# no compilation and work identically for this bot's use case.
omit=optional
